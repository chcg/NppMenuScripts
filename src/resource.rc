#include <winres.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION NPP_MENUSCRIPTS_VERSION_PARTS
 PRODUCTVERSION NPP_MENUSCRIPTS_VERSION_PARTS
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Sean Lin\0"
            VALUE "FileDescription", "NppMenuScripts Notepad++ plugin\0"
            VALUE "FileVersion", NPP_MENUSCRIPTS_VERSION_RESOURCE_STRING "\0"
            VALUE "InternalName", "NppMenuScripts\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Sean Lin\0"
            VALUE "OriginalFilename", "NppMenuScripts.dll\0"
            VALUE "ProductName", "NppMenuScripts\0"
            VALUE "ProductVersion", NPP_MENUSCRIPTS_VERSION_RESOURCE_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
